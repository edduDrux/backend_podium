# Banco de dados (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://podium:podium@localhost:5433/podium

# Redis (broker Celery + Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# Diretório de uploads
UPLOADS_DIR=./data/uploads

# Ambiente (dev / prod)
ENVIRONMENT=dev

# LLM — pelo menos uma chave para perguntas reais
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4o-mini

# Áudio — limite de upload em MB
MAX_AUDIO_UPLOAD_MB=350

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
